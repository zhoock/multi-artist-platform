# Supabase Configuration
# Скопируйте этот файл в .env.local и заполните своими значениями
# Получить значения можно в Supabase Dashboard: Settings → API

# Supabase Project URL
VITE_SUPABASE_URL=https://jhpvetvfnsklpwswadle.supabase.co

# Supabase Anon Key (публичный ключ, безопасен для клиентского кода)
VITE_SUPABASE_ANON_KEY=ваш_anon_ключ_здесь

# Для Netlify Functions (если используете)
SUPABASE_URL=https://jhpvetvfnsklpwswadle.supabase.co
SUPABASE_ANON_KEY=ваш_anon_ключ_здесь

# Включить использование Supabase Storage вместо локальных файлов
# Установите 'true' для использования Supabase Storage, 'false' для локальных файлов
VITE_USE_SUPABASE_STORAGE=false

# Audio Asset Worker (Netlify → external FFmpeg worker)
# Required for derived Opus streams after track upload when migration 064 is applied.
# Local dev: run worker on port 8090 (webpack uses 8080):
#   cd services/audio-asset-worker && PORT=8090 npm run dev
ASSET_WORKER_URL=http://localhost:8090
ASSET_WORKER_WEBHOOK_SECRET=your-shared-secret-here
