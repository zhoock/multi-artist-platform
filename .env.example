# =============================================================================
# Environment variables for local dev, Netlify build, and Netlify Functions.
# Copy to `.env` / `.env.local` and fill in secrets (never commit real secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required for Netlify Functions: albums, articles, auth, payments…)
# -----------------------------------------------------------------------------
# PostgreSQL (server-side). For Supabase serverless prefer Transaction pooler (port 6543).
# PG_POOL_MAX caps connections per Node process (shared across all Netlify function bundles).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/POSTGRES
# PG_POOL_MAX=2
# PR-10 integration E2E (tier1/tier3): dedicated Postgres; copied to DATABASE_URL in tests.
# CI uses ephemeral postgres service — see .github/workflows/pr10-e2e-quick.yml
# DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/POSTGRES_TEST

# -----------------------------------------------------------------------------
# Auth (JWT for /api/auth and protected functions)
# -----------------------------------------------------------------------------
# REQUIRED. netlify/functions/lib/jwt.ts throws on missing/empty value — there
# is no insecure fallback. Use a long random string (≥ 32 chars), e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Supabase — browser / Webpack (prefix VITE_ is injected in webpack.common.js)
# -----------------------------------------------------------------------------
# Public project URL (non-secret). This repo uses project ref jhpvetvfnsklpwswadle
# in docs and .env.local.example — confirm in your Supabase Dashboard → Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Anon (public) key — safe for frontend.
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE_STORAGE=false

# -----------------------------------------------------------------------------
# Supabase — Netlify Functions (server)
# Service role must NEVER use the VITE_ prefix (never bundle it for the browser).
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket (netlify/functions/lib/supabase.ts)
STORAGE_BUCKET_NAME=user-media

# -----------------------------------------------------------------------------
# Encryption (netlify/functions/lib/crypto.ts)
# -----------------------------------------------------------------------------
# REQUIRED. Used to encrypt/decrypt seller YooKassa secrets in DB
# (user_payment_settings.secret_key_encrypted). crypto.ts throws on missing/empty
# value — there is no insecure fallback.
#
# Recommended formats (all give a 32-byte AES-256 key):
#   - base64 of 32 random bytes (44 chars, ends with `=`):
#       openssl rand -base64 32
#   - hex of 32 random bytes (64 hex chars):
#       openssl rand -hex 32
# Any other length / charset is accepted too and is stretched via scrypt.
# Avoid `openssl rand -base64 48` — its 64-char output looks like hex by length
# but isn't a valid hex string.
#
# WARNING: changing this value after data was encrypted will make existing
# encrypted secrets unreadable. Keep it stable; rotate via re-encryption.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email (netlify/functions/lib/email.ts)
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# Resend "From" header (full format: "Display Name <noreply@example.com>")
# Falls back to legacy sender when unset — see netlify/functions/lib/email-utils.ts
# EMAIL_FROM=Название сайта <noreply@smolyanoechuchelko.ru>

# Optional display name in transactional emails (default: Mixer)
# SITE_DISPLAY_NAME=Mixer
# Platform support contact (Footer, offer page, transactional email mailto links)
# SUPPORT_EMAIL=feedback@smolyanoechuchelko.ru

# -----------------------------------------------------------------------------
# Site URL (emails, absolute links, server-side origin fallbacks)
# Netlify sets URL to http://localhost:8888 in dev — use PUBLIC_APP_URL for browser links.
# PUBLIC_APP_URL=http://localhost:8080
NETLIFY_SITE_URL=https://your-site.netlify.app

# Local Netlify CLI / hybrid dev (optional)
# NETLIFY_DEV=true

# Development Payment Mode — skip YooKassa redirect locally; uses real post-payment logic.
# Server (Netlify Functions): DEV_PAYMENT_MODE=true
# Client (Vite): VITE_DEV_PAYMENT_MODE=true
# Both required. Disabled automatically on Netlify production deploy (CONTEXT=production).
# DEV_PAYMENT_MODE=true
# VITE_DEV_PAYMENT_MODE=true

# -----------------------------------------------------------------------------
# YooKassa
# Album sales: shopId + secret per artist in DB (user_payment_settings).
# Premium subscriptions: YOOKASSA_SHOP_ID + YOOKASSA_SECRET_KEY below.
# -----------------------------------------------------------------------------
YOOKASSA_API_URL=https://api.yookassa.ru/v3/payments
YOOKASSA_RETURN_URL=
# Optional override for Premium subscription checkout (falls back to YOOKASSA_RETURN_URL)
# YOOKASSA_SUBSCRIPTION_RETURN_URL=
YOOKASSA_TEST_MODE=false
SKIP_YOOKASSA_VALIDATION=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# -----------------------------------------------------------------------------
# Premium subscription autoprenewal (PR-1+). When false/unset, legacy one-time checkout behavior only.
SUBSCRIPTION_AUTO_RENEW_ENABLED=false
# Cron secret for renewal scheduler (PR-7+; not used until enabled)
# SUBSCRIPTION_CRON_SECRET=

# Plan catalog (code): production values — Explorer 20 / Collector 60 / Archivist 100 artists,
# 30-day period, 149₽ / 149₽ / 199₽. Dev/test overrides (NOT in catalog):
#   1 RUB checkout + 1-hour support period when ANY of:
#     NETLIFY_DEV=true, NODE_ENV!=production, YOOKASSA_TEST_MODE=true
# See netlify/functions/lib/subscription-billing.ts PLAN_CATALOG.

# Premium subscription dev mock (optional, on top of subscriptions table)
# MOCK_ACTIVE_SUBSCRIPTION_USER_IDS=
# MOCK_SUBSCRIPTION_USER_ARTIST_PAIRS=

# -----------------------------------------------------------------------------
# GitHub (optional: exporting site JSON from albums function)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=zhoock
GITHUB_REPO=smolyanoe-chuchelko
GITHUB_BRANCH=main

# -----------------------------------------------------------------------------
# Audio Asset Worker (track transcoding / derived Opus)
# Netlify Functions enqueue jobs after upload (migration 064). Without these,
# uploads succeed but processing stays "not started".
# Local (host): npm run dev:all — needs brew install ffmpeg
# Local (Docker, prod-like): npm run dev:docker — ffmpeg inside container
# Worker only: npm run dev:docker:worker
# -----------------------------------------------------------------------------
ASSET_WORKER_URL=http://localhost:8090
ASSET_WORKER_WEBHOOK_SECRET=change-me-shared-with-worker

# DATABASE_URL_STAGING=
# NETLIFY_STAGING_URL=
# USE_PROD_API=
# PaymentSuccess dev preview (`?preview=success`): real Supabase cover for album "23".
# Falls back to PAYMENT_SUCCESS_PREVIEW_USER_ID, then bundled album placeholder.
# MIGRATION_TARGET_USER_ID=
# PAYMENT_SUCCESS_PREVIEW_USER_ID=

# -----------------------------------------------------------------------------
# Optional: maintenance scripts (scripts/*.ts)
# -----------------------------------------------------------------------------
# CURRENT_USER_ID=zhoock

# -----------------------------------------------------------------------------
# Node (set by tooling; rarely needed in .env)
# -----------------------------------------------------------------------------
# NODE_ENV=development
